.page { padding: 32rpx; min-height: 100vh; background: #f8fafc; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.text-input { width: 100%; height: 200rpx; font-size: 28rpx; padding: 20rpx; border: 2rpx solid #e2e8f0; border-radius: 12rpx; margin-bottom: 24rpx; }
.btn-row { display: flex; gap: 20rpx; }
.btn-primary { flex: 1; height: 80rpx; line-height: 80rpx; background: #4f46e5; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
.btn-primary[disabled] { opacity: .5; }
.btn-primary::after, .btn-outline::after { border: none; }
.btn-outline { height: 80rpx; line-height: 80rpx; padding: 0 32rpx; background: #fff; color: #64748b; font-size: 28rpx; border-radius: 12rpx; border: 2rpx solid #e2e8f0; }
.result-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.result-status { font-size: 28rpx; font-weight: 500; margin-bottom: 16rpx; }
.pass { color: #059669; }
.fail { color: #dc2626; }
.violation-item { font-size: 26rpx; color: #dc2626; padding: 8rpx 0; }
.tips { background: #fffbeb; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #fde68a; }
.tip-title { font-size: 26rpx; font-weight: 500; color: #92400e; margin-bottom: 8rpx; }
.tip-text { font-size: 24rpx; color: #a16207; }
