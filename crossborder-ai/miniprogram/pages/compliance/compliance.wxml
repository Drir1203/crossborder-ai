<view class="page">
  <view class="card">
    <textarea class="text-input" placeholder="输入要检查的文本，如：这是最好的商品，全国第一" value="{{text}}" bindinput="onInput" maxlength="2000" />
    <view class="btn-row">
      <button class="btn-primary" bindtap="onCheck" disabled="{{loading || !text.trim()}}">
        {{loading ? '检查中...' : '合规检查'}}
      </button>
      <button class="btn-outline" bindtap="onClear">清空</button>
    </view>
  </view>

  <view class="result-card" wx:if="{{result}}">
    <view class="result-status {{result.passed ? 'pass' : 'fail'}}">
      {{result.passed ? '✅ 合规，未发现违禁词' : '❌ 发现违禁词'}}
    </view>
    <view wx:if="{{result.violations && result.violations.length > 0}}">
      <view wx:for="{{result.violations}}" wx:key="index" class="violation-item">
        ⚠️ {{item}}
      </view>
    </view>
  </view>

  <view class="tips">
    <view class="tip-title">常见违禁词示例</view>
    <view class="tip-text">最、第一、绝对、永不、100%、零风险、无效退款、全国第一</view>
  </view>
</view>
