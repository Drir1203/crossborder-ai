.page { padding: 32rpx; min-height: 100vh; background: #f8fafc; }
.search-box { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.search-input {
  flex: 1; height: 88rpx; background: #fff; border-radius: 16rpx;
  padding: 0 32rpx; font-size: 28rpx; border: 2rpx solid #e2e8f0;
}
.search-btn {
  height: 88rpx; line-height: 88rpx; padding: 0 40rpx;
  background: #4f46e5; color: #fff; font-size: 28rpx; border-radius: 16rpx;
}
.search-btn[disabled] { opacity: 0.6; }
.search-btn::after { border: none; }

.history { margin-bottom: 24rpx; }
.history-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.history-title { font-size: 26rpx; color: #64748b; }
.history-clear { font-size: 24rpx; color: #94a3b8; }
.history-tags { display: flex; gap: 16rpx; white-space: nowrap; }
.history-tag {
  display: inline-block; padding: 8rpx 24rpx; background: #fff;
  border-radius: 40rpx; font-size: 24rpx; color: #4f46e5;
  border: 2rpx solid #e0e7ff; margin-right: 16rpx;
}

.report { background: #fff; border-radius: 16rpx; padding: 32rpx; }
.report-content { font-size: 24rpx; color: #334155; line-height: 1.8; }
.report-line { display: block; }

.loading { text-align: center; padding: 60rpx; color: #94a3b8; font-size: 28rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #94a3b8; }
