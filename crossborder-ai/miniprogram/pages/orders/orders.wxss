.page { padding: 32rpx; min-height: 100vh; background: #f8fafc; }
.picker { margin-bottom: 24rpx; }
.picker-btn { background: #fff; border-radius: 12rpx; padding: 24rpx 32rpx; font-size: 28rpx; color: #1e293b; display: flex; justify-content: space-between; border: 2rpx solid #e2e8f0; }
.picker-arrow { color: #94a3b8; }
.order-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.order-number { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.order-amount { font-size: 28rpx; font-weight: 600; color: #059669; }
.order-body { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.order-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; background: #f1f5f9; }
.order-status.paid { background: #d1fae5; color: #065f46; }
.order-date { font-size: 24rpx; color: #94a3b8; }
.order-email { font-size: 24rpx; color: #94a3b8; }
.empty, .loading { text-align: center; padding: 60rpx; color: #94a3b8; font-size: 28rpx; }
