.page { padding: 32rpx; min-height: 100vh; background: #f8fafc; }
.form-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: #475569; margin-bottom: 8rpx; }
.form-input {
  width: 100%; height: 80rpx; background: #f8fafc; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 28rpx; border: 2rpx solid #e2e8f0;
}
.calc-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #4f46e5; color: #fff; font-size: 30rpx; border-radius: 16rpx;
}
.calc-btn[disabled] { opacity: 0.6; }
.calc-btn::after { border: none; }

.result { background: #fff; border-radius: 16rpx; padding: 32rpx; }
.result-row { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 28rpx; color: #475569; }
.result-value { font-weight: 500; }
.result-value-bold { font-size: 32rpx; font-weight: 700; }
.result-label-bold { font-weight: 600; }
.result-divider { height: 2rpx; background: #e2e8f0; margin: 8rpx 0; }
.green { color: #059669; }
.red { color: #dc2626; }
