# ════════════════════════════════════════════════════════════════
# VeyaShip - 生产环境配置
# ════════════════════════════════════════════════════════════════
# 部署前必做：
# 1. 把此文件复制为 .env：  cp .env.production .env
# 2. 替换所有 your-* 占位符为真实值
# 3. 用 openssl 生成随机 SECRET_KEY 和 JWT_SECRET_KEY
# 4. 确保域名已指向服务器 IP
# ════════════════════════════════════════════════════════════════

# ── 应用配置 ──────────────────────────────────────────────────
APP_NAME="VeyaShip"
APP_VERSION="1.0.0"
DEBUG=false                         # 生产环境必须 false

# 用 openssl rand -hex 32 生成
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7天，卖家不需要经常登录

API_V1_PREFIX=/api/v1
PROJECT_ROOT=/app
APP_URL=https://你的域名.com       # 改成你的实际域名
BACKEND_CORS_ORIGINS=["https://你的域名.com"]

# ── 数据库 ────────────────────────────────────────────────────
USE_SQLITE=false                    # 生产环境必须 false

POSTGRES_SERVER=postgres            # Docker 内部，用服务名
POSTGRES_PORT=5432
POSTGRES_DB=crossborder_ai
POSTGRES_USER=crossborder
POSTGRES_PASSWORD=生成一个强密码     # 不要用默认密码！
# 下面这个 URL 在 Docker 里会自动拼接，一般不需要手动设
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── AI 服务 ───────────────────────────────────────────────────
# DeepSeek API Key（文案生成）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash  # 注：deepseek-chat 已弃用，用 v4 系列
DEEPSEEK_TEMPERATURE=0.7

# Replicate API Key（FLUX 图片生成）
# 申请：https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your-replicate-api-key
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ── 1688 抓取（可选） ─────────────────────────────────────────
# 如果不用 Onebound，用户需要在后台"设置"页面配置
# 也可以在这里配置全局 API Key（所有用户共用）
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=

# ── Shopify 集成（可选） ──────────────────────────────────────
# 需要在 Shopify Partners 后台创建应用获取
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=https://你的域名.com/api/v1/shopify/callback

# ── 阿里云通义万相（图片生成） ────────────────────────────────
ALIYUN_DASHSCOPE_API_KEY=sk-your-aliyun-dashscope-key
ALIYUN_IMAGE_MODEL=wanx2.1-t2i-turbo

# ── 向量数据库 ────────────────────────────────────────────────
QDRANT_HOST=qdrant                   # Docker 内部，用服务名
QDRANT_PORT=6333
QDRANT_COLLECTION=crossborder_embeddings

# ── Redis / 缓存（可选） ──────────────────────────────────────
# 不配置则使用内存缓存（单机够用）
REDIS_URL=

# ── 日志 ──────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # 生产用 INFO，调试用 DEBUG
